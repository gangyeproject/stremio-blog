---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getAdContentParts } from '../../lib/addon-ad.js';
import { getAddons, formatDate } from '../../lib/strapi.js';
import { getAddonIcon, getAddonInitials, isManifestUrl, prepareAddonContent, renderAddonContent } from '../../lib/addon-content.js';

export async function getStaticPaths() {
  const addons = await getAddons();
  return addons.filter(addon => addon.sulg).map(addon => ({
    params: { slug: addon.sulg },
    props: {
      addon,
      relatedAddons: addons.filter(related => related.sulg !== addon.sulg).slice(0, 3),
    },
  }));
}

const { addon, relatedAddons } = Astro.props;

if (!addon) {
  return Astro.redirect('/blog/addons');
}

const coverUrl = getAddonIcon(addon);
const contentParts = getAdContentParts(prepareAddonContent(addon.content || '', coverUrl));
const categories = Array.isArray(addon.types) ? addon.types.filter(type => typeof type === 'string').slice(0, 6) : [];

// Generate install URLs from manifestUrl
const manifestUrl = isManifestUrl(addon.manifestUrl) ? addon.manifestUrl : null;
const appInstallUrl = manifestUrl ? manifestUrl.replace('https://', 'stremio://') : null;
const webInstallUrl = manifestUrl ? `https://web.stremio.com/#/addons?addon=${encodeURIComponent(manifestUrl)}` : null;

---

<Layout
  title={`${addon.title} | Stremio Addon Manager`}
  description={addon.summary || `Learn about ${addon.title} addon for Stremio.`}
  image={coverUrl}
  article={{
    title: addon.title,
    summary: addon.summary,
    publishedAt: addon.publishedAt,
    slug: addon.sulg
  }}
>
  <article class="addon-article">
    <header class="addon-article__header">
      <a href="/blog/addons" class="addon-article__back">← Back to Addons</a>
      <div class="addon-article__identity">
        <div class="addon-article__icon">
          {coverUrl ? (
            <img src={coverUrl} alt={`${addon.title} icon`} width="96" height="96" decoding="async" />
          ) : (
            <span class="addon-article__initials" aria-label="No icon supplied">{getAddonInitials(addon)}</span>
          )}
        </div>
        <div class="addon-article__intro">
          <h1>{addon.title}</h1>
          {addon.summary && <p class="addon-article__summary">{addon.summary}</p>}
          {categories.length > 0 && <ul class="addon-article__categories" aria-label="Categories">
            {categories.map(category => <li>{category}</li>)}
          </ul>}
        </div>
      </div>
      <div class="addon-article__meta">
        <time datetime={addon.publishedAt}>{formatDate(addon.publishedAt)}</time>
      </div>
    </header>

    {manifestUrl && (
      <div class="install-buttons">
        <a href={appInstallUrl} class="install-btn install-btn--app">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Install on App
        </a>
        <a href={webInstallUrl} target="_blank" rel="noopener" class="install-btn install-btn--web">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          Install on Web
        </a>
      </div>
    )}


    <div class="addon-article__content" set:html={renderAddonContent(contentParts[0])} />
    <AdSlot adSlot="9291007289" format="auto" className="detail-ad" />
    <div class="addon-article__content" set:html={renderAddonContent(contentParts[1])} />
    {contentParts.length === 3 && <>
      <AdSlot adSlot="5087719225" format="fluid" layout="in-article" />
      <div class="addon-article__content" set:html={renderAddonContent(contentParts[2])} />
    </>}
  </article>

  {relatedAddons.length > 0 && (
    <section class="related-addons">
      <h2>Related Addons</h2>
      <div class="related-grid">
        {relatedAddons.map((related) => (
          <a href={`/blog/addons/${related.sulg}`} class="related-card">
            <div class="related-card__image">
              {getAddonIcon(related) ? (
                <img src={getAddonIcon(related)} alt={related.title} loading="lazy" decoding="async" />
              ) : (
                <div class="related-card__placeholder">
                  <span aria-label="No icon supplied">{getAddonInitials(related)}</span>
                </div>
              )}
            </div>
            <div class="related-card__content">
              <h3>{related.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .addon-article { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
  .addon-article__back { display: inline-block; margin-bottom: 1.5rem; color: var(--primary-color); text-decoration: none; font-weight: 500; }
  .addon-article__back:hover { text-decoration: underline; }
  .addon-article__header { margin-bottom: 1.5rem; }
  .addon-article__identity { display: flex; align-items: flex-start; gap: 1.25rem; margin-bottom: 1.25rem; }
  .addon-article__icon { flex: 0 0 96px; width: 96px; height: 96px; border: 1px solid var(--border-color); border-radius: 18px; overflow: hidden; background: #f5f2ff; }
  .addon-article__icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .addon-article__initials { display: grid; place-items: center; width: 100%; height: 100%; font-weight: 700; font-size: 1.6rem; color: #6544c9; }
  .addon-article__intro { min-width: 0; }
  .addon-article__header h1 { font-size: clamp(1.6rem, 3vw, 2.15rem); line-height: 1.25; margin: 0 0 0.75rem; color: var(--text-color); overflow-wrap: anywhere; }
  .addon-article__summary { margin: 0 0 1rem; color: var(--text-muted); font-size: 1rem; line-height: 1.65; }
  .addon-article__categories { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .addon-article__categories li { padding: 0.2rem 0.6rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.8rem; color: var(--text-muted); }
  .addon-article__meta { color: var(--text-muted); font-size: 0.95rem; }
  .install-buttons { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .install-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 1rem; text-decoration: none; transition: all 0.2s; }
  .install-btn:hover { text-decoration: none; transform: translateY(-2px); }
  .install-btn--app { background: linear-gradient(135deg, #7b5bf5 0%, #6a4be0 100%); color: #fff; box-shadow: 0 4px 14px rgba(123, 91, 245, 0.4); }
  .install-btn--app:hover { box-shadow: 0 6px 20px rgba(123, 91, 245, 0.5); color: #fff; }
  .install-btn--web { background: #fff; color: var(--primary-color); border: 2px solid var(--primary-color); }
  .install-btn--web:hover { background: var(--primary-color); color: #fff; }
  .addon-article__cover { margin-bottom: 2rem; border-radius: 12px; overflow: hidden; }
  .addon-article__cover img { display: block; width: auto; max-width: min(100%, 240px); max-height: 200px; height: auto; object-fit: contain; margin: 0 auto; }
  .addon-article__content { max-width: 68ch; margin-inline: auto; line-height: 1.8; font-size: 1.025rem; overflow-wrap: anywhere; }
  .addon-article__content :global(h2) { font-size: 1.4rem; line-height: 1.35; margin-top: 2.25rem; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border-color); color: var(--text-color); }
  .addon-article__content :global(h3) { font-size: 1.15rem; line-height: 1.4; margin-top: 1.75rem; margin-bottom: 0.75rem; color: var(--text-color); }
  .addon-article__content :global(p) { margin: 0 0 1.2rem; }
  .addon-article__content :global(ul), .addon-article__content :global(ol) { margin: 0 0 1.5rem; padding-left: 1.5rem; }
  .addon-article__content :global(li) { padding-left: 0.25rem; margin-bottom: 0.8rem; }
  .addon-article__content :global(li::marker) { color: var(--primary-color); }
  .addon-article__content :global(strong) { font-weight: 650; color: var(--text-color); }
  .addon-article__content :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-bottom: 1.5rem; }
  .addon-article__content :global(th), .addon-article__content :global(td) { padding: 0.6rem 0.8rem; border: 1px solid var(--border-color); text-align: left; }
  .addon-article__content :global(pre) { background: #f5f5f5; padding: 1rem; border-radius: 8px; overflow-x: auto; margin-bottom: 1.5rem; }
  .addon-article__content :global(code) { font-family: monospace; font-size: 0.9rem; }
  .addon-article__content :global(blockquote) { border-left: 4px solid var(--primary-color); padding-left: 1rem; margin: 1.5rem 0; color: var(--text-muted); }
  .addon-article__content :global(img) { display: block; width: auto; max-width: min(100%, 480px); max-height: 320px; height: auto; object-fit: contain; border-radius: 8px; margin: 1.25rem auto; }
  .addon-article__content :global(img[alt*="logo" i]),
  .addon-article__content :global(img[alt*="icon" i]) { max-width: min(100%, 160px); max-height: 160px; }
  .related-addons { max-width: 800px; margin: 0 auto; padding: 2rem 1rem 3rem; border-top: 1px solid var(--border-color); }
  .related-addons h2 { font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--text-color); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .related-card { background: var(--bg-color); border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: inherit; border: 1px solid var(--border-color); }
  .related-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.1); text-decoration: none; }
  .related-card__image { width: 100%; height: 96px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
  .related-card__image img { width: auto; max-width: calc(100% - 24px); height: auto; max-height: 72px; object-fit: contain; }
  .related-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.7); }
  .related-card__content { padding: 1rem; }
  .related-card__content h3 { font-size: 0.95rem; margin: 0; color: var(--text-color); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 640px) {
    .addon-article__identity { flex-direction: column; gap: 1rem; }
    .addon-article__icon { flex-basis: 80px; width: 80px; height: 80px; }
    .addon-article__header h1 { font-size: 1.65rem; }
    .addon-article__content :global(img) { max-height: 240px; }
    .addon-article__content :global(img[alt*="logo" i]),
    .addon-article__content :global(img[alt*="icon" i]) { max-width: min(100%, 128px); max-height: 128px; }
    .install-buttons { flex-direction: column; }
    .install-btn { justify-content: center; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
